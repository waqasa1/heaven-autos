# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Session signing secret. Required in production, at least 32 characters.
# Development falls back to a built-in dev secret when this is unset.
AUTH_SECRET="replace-with-a-long-random-string"

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

MONGODB_URI=

AUTH_URL=http://localhost:3000

RESEND_API_KEY=
EMAIL_FROM=

NEXT_PUBLIC_CURRENCY=
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_ADDRESS=

DEFAULT_DELIVERY_FEE=
FREE_DELIVERY_THRESHOLD=

BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_NAME=HBL
BANK_BRANCH=

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/api/payments/easypaisa/return

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# false → checkout offers COD + manual EasyPaisa (bank/JazzCash/PayFast removed)
CHECKOUT_COD_ONLY=false

